# ─── Razorpay (TEST MODE ONLY) ──────────────────────────
# Get test keys from: https://dashboard.razorpay.com/app/keys
# MUST start with rzp_test_ — live keys will be REJECTED
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_SECRET

# ─── Local LLM (Ollama) ─────────────────────────────────
# Install Ollama: https://ollama.com/download
# Then pull a model: ollama pull llama3.2
# The app works without Ollama (rule-based fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Database ───────────────────────────────────────────
DATABASE_URL=sqlite:///./agentready.db

# ─── Firebase Admin SDK ─────────────────────────────────
# Path to service account JSON (relative to backend/ or project root)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=agent-ray
FIREBASE_DATABASE_URL=https://agent-ray-default-rtdb.asia-southeast1.firebasedatabase.app

# ─── Sarvam AI (Voice Assistant) ────────────────────────
# Get your API key from https://dashboard.sarvam.ai
# Enables multi-lingual Speech-to-Text (Saaras v3) and Text-to-Speech (Bulbul v3)
SARVAM_API_KEY=your_sarvam_api_key_here
